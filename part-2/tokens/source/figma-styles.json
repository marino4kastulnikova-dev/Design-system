{
  "$comment": "Source: Figma file AfiYjkdFU2Flc69Qgpw7yv, local paint, effect and text styles. Extracted 2026-10-07 (see scripts/figma-extract.md). Gradient transforms are Figma gradientTransform matrices; colours are sRGB hex, 'a' is stop alpha, 'opacity' is paint opacity. Effect colours are sRGB 0-1 with alpha.",
  "gradients": [
    { "name": "gradient-dark", "paints": [{ "type": "GRADIENT_LINEAR", "transform": [[0.707, 0.707, -0.207], [-0.707, 0.707, 0.5]], "stops": [{ "color": "#334057", "position": 0 }, { "color": "#080a12", "position": 1 }] }] },
    { "name": "gradient-purple", "paints": [{ "type": "GRADIENT_LINEAR", "transform": [[0.465, 0.544, 0.034], [-0.544, 0.465, 0.529]], "stops": [{ "color": "#8345d5", "position": 0 }, { "color": "#300071", "position": 1 }] }] },
    { "name": "gradient-progress", "description": "Progress bar fill on wallet cards. Observed 2× (IBAN + Wallet card), #9eed73 → #40cc8c.", "paints": [{ "type": "GRADIENT_LINEAR", "transform": [[1, 0, 0], [0, 1, 0]], "stops": [{ "color": "#9eed73", "position": 0 }, { "color": "#40cc8c", "position": 1 }] }] },
    { "name": "gradient-card-iban", "description": "IBAN account card surface (7-stop purple gradient + 45% black overlay layer). Observed 1×.", "paints": [{ "type": "GRADIENT_LINEAR", "transform": [[0, -1, 1], [0.496, -0.001, 0.252]], "stops": [{ "color": "#180d2b", "position": 0.008 }, { "color": "#22123d", "position": 0.21 }, { "color": "#251345", "position": 0.328 }, { "color": "#340d64", "position": 0.506 }, { "color": "#3d0376", "position": 0.612 }, { "color": "#4c128b", "position": 0.752 }, { "color": "#6e0cb4", "position": 1 }] }, { "type": "SOLID", "color": "#000000", "opacity": 0.45 }] },
    { "name": "gradient-glow", "description": "Radial ambient glow behind convert swap button / AI orb. Observed 2× identical.", "paints": [{ "type": "GRADIENT_RADIAL", "opacity": 0.3, "transform": [[0.61, 0.434, -0.032], [-0.452, 0.606, 0.408]], "stops": [{ "color": "#a66bf2", "a": 0.55, "position": 0 }, { "color": "#b280f2", "a": 0.28, "position": 0.689 }, { "color": "#ffffff", "a": 0, "position": 1 }] }] },
    { "name": "gradient-purple-subtle", "description": "Selected menu item background: #a663ff → #300071 at 20% (Observed on sidebar \"Home\"). Distinct from gradient-purple (#8345d5 → #300071, 100%). Approved by Mary 2026-09-21.", "paints": [{ "type": "GRADIENT_LINEAR", "opacity": 0.2, "transform": [[0.465, 0.544, 0.034], [-0.544, 0.465, 0.529]], "stops": [{ "color": "#a663ff", "position": 0 }, { "color": "#300071", "position": 1 }] }] },
    { "name": "gradient-spinner", "paints": [{ "type": "GRADIENT_LINEAR", "transform": [[0, 1, 0], [-1, 0, 1]], "stops": [{ "color": "#a663ff", "position": 0 }, { "color": "#300071", "position": 1 }] }] },
    { "name": "gradient-ai-panel", "paints": [{ "type": "GRADIENT_LINEAR", "transform": [[0, 1, 0], [-1, 0, 1]], "stops": [{ "color": "#e5defa", "a": 0.5, "position": 0 }, { "color": "#dbd2f6", "a": 0.5, "position": 0.523 }, { "color": "#d1c7f2", "a": 0.8, "position": 1 }] }] },
    { "name": "gradient-ai-orb-glow", "paints": [{ "type": "GRADIENT_RADIAL", "transform": [[0.856, 0.837, -0.22], [-0.88, 0.856, 0.554]], "stops": [{ "color": "#a66bf2", "a": 0.55, "position": 0 }, { "color": "#b280f2", "a": 0.28, "position": 0.689 }, { "color": "#ffffff", "a": 0, "position": 1 }] }] },
    { "name": "gradient-ai-orb-base", "paints": [{ "type": "GRADIENT_RADIAL", "opacity": 0.09, "transform": [[0.85, -0.5, 0.32], [0.5, 0.85, 0.05]], "stops": [{ "color": "#f2edfc", "position": 0 }, { "color": "#d1baf5", "position": 0.42 }, { "color": "#996bdb", "position": 0.75 }, { "color": "#54218c", "position": 1 }] }] },
    { "name": "gradient-ai-orb-rim", "paints": [{ "type": "GRADIENT_RADIAL", "opacity": 0.6, "transform": [[1, 0, 0], [0, 1, 0]], "stops": [{ "color": "#6b3d99", "a": 0, "position": 0.82 }, { "color": "#5c298c", "a": 0.45, "position": 0.92 }, { "color": "#4d1a7a", "a": 0.2, "position": 0.97 }, { "color": "#400f6b", "a": 0, "position": 1 }] }] },
    { "name": "gradient-ai-orb-highlight-wide", "paints": [{ "type": "GRADIENT_RADIAL", "transform": [[1, 0, 0], [0, 1, 0]], "stops": [{ "color": "#ffffff", "a": 0.35, "position": 0 }, { "color": "#ffffff", "a": 0, "position": 1 }] }] },
    { "name": "gradient-ai-orb-highlight-big", "paints": [{ "type": "GRADIENT_RADIAL", "transform": [[1, 0, 0], [0, 1, 0]], "stops": [{ "color": "#ffffff", "a": 0.9, "position": 0 }, { "color": "#ffffff", "a": 0.5, "position": 0.5 }, { "color": "#ffffff", "a": 0, "position": 1 }] }] },
    { "name": "gradient-ai-orb-highlight-small", "paints": [{ "type": "GRADIENT_RADIAL", "transform": [[1, 0, 0], [0, 1, 0]], "stops": [{ "color": "#ffffff", "a": 0.95, "position": 0 }, { "color": "#ffffff", "a": 0, "position": 1 }] }] }
  ],
  "effects": [
    { "name": "shadow/soft", "description": "Soft purple-tinted elevation, no black. Used for hover on filled controls (Button primary/tonal, IconButton) and for Tooltip. Approved by Mary 2026-09-21; renamed from shadow/control-hover 2026-10-02.", "layers": [{ "type": "DROP_SHADOW", "x": 0, "y": 8, "radius": 20, "spread": -6, "color": [0.463, 0.392, 0.639, 0.22] }, { "type": "DROP_SHADOW", "x": 0, "y": 2, "radius": 6, "spread": -1, "color": [0.463, 0.392, 0.639, 0.12] }] },
    { "name": "shadow/dropdown", "description": "Dropdown panel elevation (#0d051f @16% 0/12/28/-6 + @8% 0/2/6/0). Chosen: same shadow colour as modals; the library \"shadow\" style (#300071 10%/8%) is legacy.", "layers": [{ "type": "DROP_SHADOW", "x": 0, "y": 12, "radius": 28, "spread": -6, "color": [0.05, 0.02, 0.12, 0.16] }, { "type": "DROP_SHADOW", "x": 0, "y": 2, "radius": 6, "spread": 0, "color": [0.05, 0.02, 0.12, 0.08] }] },
    { "name": "shadow/modal", "description": "Modal window elevation. Observed identical on all 5 modals (#0d051f @18% 0/24/48/-8 + @10% 0/4/12/0).", "layers": [{ "type": "DROP_SHADOW", "x": 0, "y": 24, "radius": 48, "spread": -8, "color": [0.05, 0.02, 0.12, 0.18] }, { "type": "DROP_SHADOW", "x": 0, "y": 4, "radius": 12, "spread": 0, "color": [0.05, 0.02, 0.12, 0.1] }] },
    { "name": "glass/default", "description": "Frosted/glass surface effect (GLASS r4). Observed raw on 12+ nodes and via remote style \"glass\" on 2.", "layers": [{ "type": "GLASS", "radius": 4, "refraction": 0.8, "depth": 20, "lightAngle": 306, "lightIntensity": 0.8, "dispersion": 0.5, "splay": 0 }] }
